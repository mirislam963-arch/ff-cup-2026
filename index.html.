
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FF CUP 2026</title>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0; padding: 25px 16px; min-height: 100vh;
      background: #07111f; color: white;
      font-family: Arial, sans-serif;
      display: flex; justify-content: center; align-items: center;
    }
    .panel {
      width: 100%; max-width: 430px; padding: 28px;
      background: #101f32; border: 1px solid #1c91bd;
      border-radius: 18px;
    }
    h1 { color: #36d5ff; text-align: center; }
    p { color: #a9c0d5; text-align: center; }
    input, button {
      width: 100%; padding: 14px; margin-top: 14px;
      border-radius: 9px; font-size: 16px;
    }
    input { background: #07111f; color: white; border: 1px solid #31506a; }
    button {
      border: 0; background: #19bce9; color: #06111d;
      font-weight: bold; cursor: pointer;
    }
    #message { margin-top: 16px; }
  </style>
</head>
<body>
  <main class="panel">
    <h1>FF CUP 2026</h1>
    <p>GLOBAL SOLO SERIES</p>
    <p>Регистрация участников</p>

    <input id="nickname" placeholder="Free Fire nickname">
    <input id="uid" placeholder="Free Fire UID">
    <button onclick="registerPlayer()">ЗАРЕГИСТРИРОВАТЬСЯ</button>
    <p id="message"></p>
  </main>

  <script>
    const SUPABASE_URL = "https://rciwumuqhwpncviyojnj.supabase.co";
    const SUPABASE_KEY = "sb_publishable_t6mgrMh69tBD7dy021EnIA_SbWwJg6n";

    const db = supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

    async function registerPlayer() {
      const nickname = document.getElementById("nickname").value.trim();
      const uid = document.getElementById("uid").value.trim();
      const message = document.getElementById("message");

      if (!nickname || !uid) {
        message.textContent = "Заполни оба поля.";
        return;
      }

      message.textContent = "Отправляем заявку...";

      const { error } = await db.from("players").insert({
        nickname: nickname,
        game_uid: uid,
        status: "pending"
      });

      if (error) {
        message.textContent = "Не удалось отправить заявку. Проверь данные.";
      } else {
        message.textContent = "Заявка успешно отправлена!";
      }
    }
  </script>
</body>
</html>

